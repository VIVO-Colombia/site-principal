# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Branding (optional overrides)
# NEXT_PUBLIC_PRODUCT_NAME=VIVO Planner

# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never expose this key to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare Turnstile — Dashboard > Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Super Admin is never assigned from public signup.
# Promote an account with supabase/README.md after the user exists.
# Do not put emails or passwords here.
