# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Branding (optional overrides)
# NEXT_PUBLIC_PRODUCT_NAME=VIVO Planner

# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never expose this key to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare Turnstile — Dashboard > Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Commercial contact. Leave empty until the channel is official.
# NEXT_PUBLIC_CONTACT_EMAIL=
# NEXT_PUBLIC_CONTACT_WHATSAPP=

# Optional HTTPS endpoint that receives commercial leads as JSON.
# Forms stay hidden until there is a destination (service role + migration 0007, or this webhook)
# and, in production, Cloudflare Turnstile is configured.
# LEAD_WEBHOOK_URL=

# Optional Plausible domain. Events are not sent when this is empty.
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# Super Admin is never assigned from public signup.
# Promote an account with supabase/README.md after the user exists.
# Do not put emails or passwords here.
